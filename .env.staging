# Staging Environment Variables for IAM Service
SPRING_PROFILES_ACTIVE=dev

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=iam_staging
DB_USERNAME=iam
DB_PASSWORD=${POSTGRES_PASSWORD}

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=iam
RABBITMQ_PASSWORD=${RABBITMQ_PASSWORD}

# Mail Configuration
MAIL_HOST=${SMTP_HOST}
MAIL_PORT=${SMTP_PORT}
MAIL_USERNAME=${SMTP_USERNAME}
MAIL_PASSWORD=${SMTP_PASSWORD}
MAIL_FROM=noreply@iqkv.site

# JWT RS256 Key Configuration
JWT_PRIVATE_KEY_PATH=file:/run/secrets/private.pem
JWT_PUBLIC_KEY_PATH=file:/run/secrets/public.pem

# Application URLs
APP_BASE_URL=${APP_BASE_URL}

# PostgreSQL container vars
POSTGRES_DB=iam_staging
POSTGRES_USER=iam
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
