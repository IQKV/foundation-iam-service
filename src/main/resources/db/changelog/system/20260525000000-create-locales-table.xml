<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.33.xsd">

    <changeSet id="20260525000000-create-locales-table" author="iqkv">
        <createTable tableName="locales" schemaName="public">
            <column name="code" type="VARCHAR(20)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="native_name" type="VARCHAR(50)"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="is_default" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createIndex indexName="idx_locales_is_active" tableName="locales" schemaName="public">
            <column name="is_active"/>
        </createIndex>
        
        <rollback>
            <dropIndex indexName="idx_locales_is_active" tableName="locales" schemaName="public"/>
            <dropTable tableName="locales" schemaName="public"/>
        </rollback>
    </changeSet>

    <changeSet id="20260525000000-default-locale-en-us" author="iqkv">
        <insert tableName="locales" schemaName="public">
            <column name="code" value="en-US"/>
            <column name="name" value="English (US)"/>
            <column name="native_name" value="English (US)"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="is_default" valueBoolean="true"/>
        </insert>
        <rollback>
            <delete tableName="locales" schemaName="public">
                <where>code IN ('en-US')</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
