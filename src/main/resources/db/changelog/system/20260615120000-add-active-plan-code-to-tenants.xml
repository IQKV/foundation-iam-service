<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20260615120000-add-active-plan-code-to-tenants" author="iqkv">
        <addColumn tableName="tenants" schemaName="public">
            <column name="active_plan_code" type="VARCHAR(64)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <sql>
            COMMENT
            ON COLUMN public.tenants.active_plan_code IS
            'Human-readable plan code cached from the billing service (e.g. pro-monthly). '
            'Stamped into JWT access tokens as the plan_code claim. '
            'Null until the tenant activates a paid subscription.';
        </sql>

        <rollback>
            <dropColumn tableName="tenants" schemaName="public" columnName="active_plan_code"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
