<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20260115120000" author="iqkv">
        <createTable tableName="tenants" schemaName="public">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_key" type="VARCHAR(12)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_tenants_tenant_key"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_tenants_name"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="updated_by" type="VARCHAR(255)"/>
        </createTable>

        <createIndex indexName="idx_tenants_tenant_key" tableName="tenants" schemaName="public" unique="true">
            <column name="tenant_key"/>
        </createIndex>

        <createIndex indexName="idx_tenants_name" tableName="tenants" schemaName="public" unique="true">
            <column name="name"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260115120000-platform-tenant-record" author="iqkv">
        <insert tableName="tenants" schemaName="public">
            <column name="id" value="00000000-0000-0000-0000-000000000001"/>
            <column name="tenant_key" value="platform"/>
            <column name="name" value="Platform Tenant"/>
            <column name="status" value="ACTIVE"/>
            <column name="created_at" valueDate="2026-01-15T12:00:00"/>
            <column name="updated_at" valueDate="2026-01-15T12:00:00"/>
            <column name="created_by" value="system"/>
            <column name="updated_by" value="system"/>
        </insert>
        <rollback>
            <delete tableName="tenants" schemaName="public">
                <where>tenant_key = 'platform'</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
