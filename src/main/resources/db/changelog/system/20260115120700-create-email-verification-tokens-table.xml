<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20260115120700" author="iqscaffold">
        <createTable tableName="email_verification_tokens" schemaName="public">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_email_verification_tokens_user_id"
                             references="public.users(id)"
                             deleteCascade="true"/>
            </column>
            <column name="token" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_email_verification_tokens_token"/>
            </column>
            <column name="expires_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="resend_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="last_resend_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_email_verification_tokens_token" tableName="email_verification_tokens" schemaName="public" unique="true">
            <column name="token"/>
        </createIndex>

        <createIndex indexName="idx_email_verification_tokens_user_id" tableName="email_verification_tokens" schemaName="public">
            <column name="user_id"/>
        </createIndex>

        <createIndex indexName="idx_email_verification_tokens_expires_at" tableName="email_verification_tokens" schemaName="public">
            <column name="expires_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
