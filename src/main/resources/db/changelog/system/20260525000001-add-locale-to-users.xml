<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.33.xsd">

    <changeSet id="20260525000001-add-locale-to-users" author="iqkv">
        <addColumn tableName="users" schemaName="public">
            <column name="locale" type="VARCHAR(20)" defaultValue="en-US">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        
        <rollback>
            <dropColumn tableName="users" schemaName="public" columnName="locale"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
