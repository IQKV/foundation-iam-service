<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!--
        Adds a dedicated tenant owner user for demo0001.

        User     : tenant.owner@demo.iqkv.com
        Password : TenantOwner123!  (BCrypt 12)
        UUID     : 00000000-0000-0000-0001-000000000032
        Authority: TENANT_OWNER

        Sign-in  : POST /api/v1/iam/auth/signin
                   Header: X-Tenant-ID: demo0001
    -->

    <changeSet id="20260511000000-demo-tenant-owner-user" author="iqkv" context="demo">
        <insert tableName="users" schemaName="public">
            <column name="id"             value="00000000-0000-0000-0001-000000000032"/>
            <column name="email"          value="tenant.owner@demo.iqkv.com"/>
            <!-- TenantOwner123! — BCrypt cost 12 -->
            <column name="password_hash"  value="$2a$12$XfKe/7oVzBAvPbTSM5vBG.hhwQTFoWxXbwmAy6.9h6hLIElo5c1MK"/>
            <column name="first_name"     value="Tenant"/>
            <column name="last_name"      value="Owner"/>
            <column name="status"         value="ACTIVE"/>
            <column name="email_verified" valueBoolean="true"/>
            <column name="created_at"     valueDate="2026-05-11T12:00:00"/>
            <column name="updated_at"     valueDate="2026-05-11T12:00:00"/>
            <column name="created_by"     value="system"/>
            <column name="updated_by"     value="system"/>
        </insert>
        <rollback>
            <delete tableName="users" schemaName="public">
                <where>id = '00000000-0000-0000-0001-000000000032'</where>
            </delete>
        </rollback>
    </changeSet>

    <changeSet id="20260511000000-demo-tenant-owner-membership" author="iqkv" context="demo">
        <insert tableName="tenant_memberships" schemaName="public">
            <column name="id"         value="00000000-0000-0000-0002-000000000032"/>
            <column name="user_id"    value="00000000-0000-0000-0001-000000000032"/>
            <column name="tenant_key" value="demo0001"/>
            <column name="status"     value="ACTIVE"/>
            <column name="created_at" valueDate="2026-05-11T12:00:00"/>
            <column name="updated_at" valueDate="2026-05-11T12:00:00"/>
            <column name="created_by" value="system"/>
            <column name="updated_by" value="system"/>
        </insert>
        <rollback>
            <delete tableName="tenant_memberships" schemaName="public">
                <where>id = '00000000-0000-0000-0002-000000000032'</where>
            </delete>
        </rollback>
    </changeSet>

    <changeSet id="20260511000000-demo-tenant-owner-authority" author="iqkv" context="demo">
        <insert tableName="tenant_member_authorities" schemaName="public">
            <column name="id"            value="00000000-0000-0000-0003-000000000032"/>
            <column name="membership_id" value="00000000-0000-0000-0002-000000000032"/>
            <column name="authority"     value="TENANT_OWNER"/>
        </insert>
        <rollback>
            <delete tableName="tenant_member_authorities" schemaName="public">
                <where>id = '00000000-0000-0000-0003-000000000032'</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
