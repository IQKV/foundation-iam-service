<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20260525000000-demo-locales" author="iqkv" context="demo">
        <insert tableName="locales" schemaName="public">
            <column name="code" value="gn-PY"/>
            <column name="name" value="Guarani"/>
            <column name="native_name" value="Guarani"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="is_default" valueBoolean="false"/>
        </insert>
        <insert tableName="locales" schemaName="public">
            <column name="code" value="qu-PE"/>
            <column name="name" value="Quechua"/>
            <column name="native_name" value="Quechua"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="is_default" valueBoolean="false"/>
        </insert>
        <rollback>
            <delete tableName="locales" schemaName="public">
                <where>code IN ('gn-PY', 'qu-PE')</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
