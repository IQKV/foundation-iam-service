<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20260604120000" author="iqkv">
        <addColumn tableName="tenants" schemaName="public">
            <column name="is_internal" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn tableName="tenants" schemaName="public" columnName="is_internal"/>
        </rollback>
    </changeSet>

    <changeSet id="20260604120001" author="iqkv">
        <update tableName="tenants" schemaName="public">
            <column name="is_internal" valueBoolean="true"/>
            <where>tenant_key = 'platform'</where>
        </update>
        <rollback>
            <update tableName="tenants" schemaName="public">
                <column name="is_internal" valueBoolean="false"/>
                <where>tenant_key = 'platform'</where>
            </update>
        </rollback>
    </changeSet>

</databaseChangeLog>
