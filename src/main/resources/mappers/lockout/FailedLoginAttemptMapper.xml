<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iqkv.iamservice.lockout.FailedLoginAttemptMapper">

    <resultMap id="failedLoginAttemptResultMap" type="com.iqkv.iamservice.lockout.FailedLoginAttempt">
        <id     property="id"          column="id"/>
        <result property="email"       column="email"/>
        <result property="attemptedAt" column="attempted_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.iqkv.iamservice.lockout.FailedLoginAttempt">
        INSERT INTO public.failed_login_attempts
            (id, email, attempted_at)
        VALUES
            (#{id}, #{email}, #{attemptedAt})
    </insert>

    <select id="countByEmailAndAttemptedAtAfter" resultType="long">
        SELECT COUNT(*)
        FROM public.failed_login_attempts
        WHERE email = #{email}
          AND attempted_at &gt; #{since}
    </select>

    <delete id="deleteByEmail">
        DELETE FROM public.failed_login_attempts
        WHERE email = #{email}
    </delete>

</mapper>
