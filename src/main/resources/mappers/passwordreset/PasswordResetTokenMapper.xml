<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iqkv.foundation.iamservice.passwordreset.PasswordResetTokenMapper">

    <resultMap id="passwordResetTokenResultMap" type="com.iqkv.foundation.iamservice.passwordreset.PasswordResetToken">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="token" column="token"/>
        <result property="expiresAt" column="expires_at"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.iqkv.foundation.iamservice.passwordreset.PasswordResetToken">
        INSERT INTO public.password_reset_tokens
        (id, user_id, token, expires_at, created_at)
        VALUES
        (#{id}, #{userId}, #{token}, #{expiresAt}, #{createdAt})
    </insert>

    <select id="findByToken" resultMap="passwordResetTokenResultMap">
        SELECT id, user_id, token, expires_at, created_at
        FROM public.password_reset_tokens
        WHERE token = #{token}
    </select>

    <delete id="deleteByToken">
        DELETE FROM public.password_reset_tokens
        WHERE token = #{token}
    </delete>

    <delete id="deleteByUserId">
        DELETE FROM public.password_reset_tokens
        WHERE user_id = #{userId}
    </delete>

    <delete id="deleteByExpiresAtBefore">
        DELETE FROM public.password_reset_tokens
        WHERE expires_at &lt; #{cutoff}
    </delete>

    <select id="countByUserIdAndCreatedAtAfter" resultType="int">
        SELECT COUNT(*)
        FROM public.password_reset_tokens
        WHERE user_id = #{userId}
        AND created_at &gt; #{since}
    </select>

</mapper>
