# Local Development Environment Variables for IAM Service
SPRING_PROFILES_ACTIVE=local

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=iam
DB_USERNAME=iam
DB_PASSWORD=iam

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=iam
RABBITMQ_PASSWORD=iam

# Mail Configuration (MailHog)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@iqkv.site

# JWT RS256 Key Configuration
JWT_PRIVATE_KEY_PATH=classpath:keys/private.pem
JWT_PUBLIC_KEY_PATH=classpath:keys/public.pem
JWT_ISSUER=foundation-iam-service

# Application URLs
APP_BASE_URL=http://localhost:3000

# PostgreSQL container vars
POSTGRES_DB=iam
POSTGRES_USER=iam
POSTGRES_PASSWORD=iam
