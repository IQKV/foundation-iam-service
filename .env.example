# iQ Key Value IAM Service Environment Variables Template
# Copy this file to .env.local, .env.uat, or .env.prd and configure values

# =============================================================================
# Spring Profile Configuration
# =============================================================================
SPRING_PROFILES_ACTIVE=local

# =============================================================================
# Platform Rollout Mode
# =============================================================================
# MULTI_TENANT (default) or SINGLE_TENANT
# Must be identical across IAM, Billing, and Gateway services
ROLLOUT_MODE=MULTI_TENANT

# =============================================================================
# Database Configuration
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=iamservice
DB_USERNAME=svc_iam_dba
DB_PASSWORD=svc_iam_dba

# =============================================================================
# PostgreSQL container vars (used by postgres image directly)
# =============================================================================
POSTGRES_DB=iamservice
POSTGRES_USER=svc_iam_dba
POSTGRES_PASSWORD=svc_iam_dba

# =============================================================================
# RabbitMQ Messaging Configuration
# =============================================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=svc_iam_rmq
RABBITMQ_PASSWORD=svc_iam_rmq

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=PT2S

# =============================================================================
# Mail Configuration
# =============================================================================
# Email transport provider: smtp (default) or resend
MAIL_PROVIDER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@iqkv.com
MAIL_REPLY_TO=

# Resend API key — required only when MAIL_PROVIDER=resend
# Obtain from https://resend.com/api-keys
# The sending domain must be verified in the Resend dashboard
RESEND_API_KEY=

# =============================================================================
# Object Storage Configuration (MinIO / S3)
# =============================================================================
OBJECTSTORAGE_ENDPOINT=http://localhost:9000
OBJECTSTORAGE_ACCESS_KEY=iqkv
OBJECTSTORAGE_SECRET_KEY=iqkv_password
OBJECTSTORAGE_BUCKET_NAME=iam-assets
OBJECTSTORAGE_REGION=us-east-1
OBJECTSTORAGE_SSL=false

# =============================================================================
# JWT RS256 Key Configuration
# =============================================================================
JWT_PRIVATE_KEY_PATH=classpath:keys/private.pem
JWT_PUBLIC_KEY_PATH=classpath:keys/public.pem

# =============================================================================
# Application URLs
# =============================================================================
APP_BASE_URL=http://localhost:3000

# =============================================================================
# Single-Tenancy Mode Configuration
# =============================================================================
# Default tenant key for SINGLE_TENANT mode (optional)
# If not set, IAM will resolve from database or auto-generate a NanoID
# Format: 8-character NanoID using alphabet [a-z0-9], e.g. abc12345
DEFAULT_TENANT_KEY=

# Display name for the default tenant in SINGLE_TENANT mode
DEFAULT_TENANT_NAME=Acme Corp.
